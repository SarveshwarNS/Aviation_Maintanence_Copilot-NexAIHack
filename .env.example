# Google AI / Gemini API Credentials
# Replace with your actual key in .env (never commit .env to version control)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Secondary / Fallback API Key (automatically rotated if rate limits/quotas are reached)
# GEMINI_API_KEY_FALLBACK=your_secondary_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# Optional: Preferred model or custom model cascade (comma-separated priority list)
# Default built-in cascade: gemini-3-flash-preview, gemini-3.5-flash, gemini-3.1-flash-lite-preview, gemini-3.8-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.1-flash-lite-preview,gemini-3.8-flash
